{
  "routes": [
    { "route": "/app", "rewrite": "/app.html" },
    { "route": "/history", "rewrite": "/history.html" },
    { "route": "/.auth/login/twitter", "statusCode": 404 },
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=300" } },
    { "route": "/vendor/*", "headers": { "Cache-Control": "public, max-age=604800, immutable" } }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "globalHeaders": {
    "Permissions-Policy": "microphone=(self)",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": { ".js": "text/javascript", ".svg": "image/svg+xml", ".webmanifest": "application/manifest+json" },
  "platform": { "apiRuntime": "node:20" }
}
